cts">812386b4-c9cf-4227-bd69-4146df5a97f9</TargetGuid><TargetX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1877</TargetX><TargetY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">569</TargetY></a:Value></a:KeyValueOfguidanyType></Lines><Zoom>1</Zoom></DrawingSurfaceModel></DrawingSurfaceList><MetaInformation><Assumptions/><Contributors/><ExternalDependencies/><HighLevelSystemDescription/><Owner/><Reviewer/><ThreatModelName/></MetaInformation><Notes/><ThreatInstances xmlns:a="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4300fef01-3e35-4607-9161-0616ee4df07e3ecc6f11-efab-427b-a2e0-8cf00b753884311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3ecc6f11-efab-427b-a2e0-8cf00b753884</b:FlowGuid><b:Id>7</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:3ecc6f11-efab-427b-a2e0-8cf00b753884:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:54:18.4563484+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Login Credentials Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Login Credentials data flow is in-process: from Scanner(System.in) to AuthService.login(). There is no network channel that could be disrupted. A console disconnect ends the session cleanly; no partial credential reaches the verification logic because Scanner.nextLine() returns only complete input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3300fef01-3e35-4607-9161-0616ee4df07e3ecc6f11-efab-427b-a2e0-8cf00b753884311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3ecc6f11-efab-427b-a2e0-8cf00b753884</b:FlowGuid><b:Id>6</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:3ecc6f11-efab-427b-a2e0-8cf00b753884:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:54:11.4337626+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mitigated by Fail Securely : InputValidator.isValidUsername() is a pure regex-matching function with no I/O — it cannot crash from external causes. AuthService.login() wraps every step in try/catch. The top-level App.main() has a catch(Throwable) that logs fatal errors via AuditLogger before exit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6300fef01-3e35-4607-9161-0616ee4df07e3ecc6f11-efab-427b-a2e0-8cf00b753884311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3ecc6f11-efab-427b-a2e0-8cf00b753884</b:FlowGuid><b:Id>5</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:3ecc6f11-efab-427b-a2e0-8cf00b753884:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:51:18.4133816+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  claims that it did not receive data from a source outside the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mitigated by SEC-AUTH-05 + audit logging (FR-SYS-05): AuditLogger records every login attempt — both successes (LOGIN OK) and failures (BAD_INPUT, BAD_PASSWORD, NO_SUCH_USER, BLOCKED_LOCKED) — with timestamp, username, and outcome. The user cannot deny initiating the login because the attempt is permanently recorded.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S3300fef01-3e35-4607-9161-0616ee4df07e3ecc6f11-efab-427b-a2e0-8cf00b753884311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3ecc6f11-efab-427b-a2e0-8cf00b753884</b:FlowGuid><b:Id>4</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:3ecc6f11-efab-427b-a2e0-8cf00b753884:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:47:12.0270872+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Customer External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Customer may be spoofed by an attacker and this may lead to unauthorized access to 1.1 Validate Input . </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mitigated by SEC-AUTH-01: every login passes through AuthService.login() which verifies credentials using PBKDF2-HMAC-SHA-256 with 65,536 iterations and per-user 16-byte SecureRandom salt (PasswordHasher.verify). An attacker cannot spoof a Customer without knowing the plaintext password. The identical error message "Invalid username or password." is returned for both unknown usernames and wrong passwords (SEC-AUTH-05) to prevent username enumeration.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5300fef01-3e35-4607-9161-0616ee4df07e3ecc6f11-efab-427b-a2e0-8cf00b753884311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3ecc6f11-efab-427b-a2e0-8cf00b753884</b:FlowGuid><b:Id>8</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:3ecc6f11-efab-427b-a2e0-8cf00b753884:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:56:53.2382368+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  may be able to impersonate the context of Customer in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mitigated by SEC-LOCK-03 (Role-Based Menu Dispatch) + SEC-AUTH-01 (PBKDF2 verification): the user's role is read from users.dat at login time and verified against the hashed password. App.java's switch(role) constructs only the menu for that role — no impersonation path exists because each menu is a separate object with no cross-references.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6300fef01-3e35-4607-9161-0616ee4df07e3ecc6f11-efab-427b-a2e0-8cf00b753884311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3ecc6f11-efab-427b-a2e0-8cf00b753884</b:FlowGuid><b:Id>9</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:3ecc6f11-efab-427b-a2e0-8cf00b753884:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:56:55.5915798+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>1.1 Validate Input  May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Customer may be able to remotely execute code for 1.1 Validate Input .</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>ShipTrack is a console-only application with NO network listener, NO HTTP endpoint, and NO deserialization of untrusted input. The only input channel is Scanner(System.in) processing plain text via regex matchers. There is no remote-code-execution attack surface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7300fef01-3e35-4607-9161-0616ee4df07e3ecc6f11-efab-427b-a2e0-8cf00b753884311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3ecc6f11-efab-427b-a2e0-8cf00b753884</b:FlowGuid><b:Id>10</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:3ecc6f11-efab-427b-a2e0-8cf00b753884:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:56:58.0936309+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 1.1 Validate Input  in order to change the flow of program execution within 1.1 Validate Input  to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>InputValidator methods are pure regex-based validators with no side effects and no dynamic code paths. Execution flow cannot be changed by input — there is no conditional logic that branches based on input content beyond accept/reject. SEC-INP-01 enforces strict allow-list (^[A-Za-z0-9._-]{3,20}$).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261300fef01-3e35-4607-9161-0616ee4df07e3ecc6f11-efab-427b-a2e0-8cf00b753884311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3ecc6f11-efab-427b-a2e0-8cf00b753884</b:FlowGuid><b:Id>11</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:3ecc6f11-efab-427b-a2e0-8cf00b753884:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-05-14T00:03:55.3643186+03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting. The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Not applicable — ShipTrack is a console application, not a web application. There are no HTTP cookies, no browser sessions, no cross-site contexts. CSRF is impossible by design (Attack Surface Reduction, Ch.2).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S3241166ce-6cfd-4969-9002-c2cd244c13c856df70a9-6f9d-4223-ae36-6ebfda21b350311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>56df70a9-6f9d-4223-ae36-6ebfda21b350</b:FlowGuid><b:Id>12</b:Id><b:InteractionKey>241166ce-6cfd-4969-9002-c2cd244c13c8:56df70a9-6f9d-4223-ae36-6ebfda21b350:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:46:52.7929244+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Dispatcher External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Dispatcher may be spoofed by an attacker and this may lead to unauthorized access to 1.1 Validate Input . </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Same PBKDF2 password verification protects all roles. The Dispatcher's role is read freshly from users.dat on every login  — there are no session tokens that could be replayed. A demoted Dispatcher cannot continue acting as one after the role change.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>241166ce-6cfd-4969-9002-c2cd244c13c8</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6241166ce-6cfd-4969-9002-c2cd244c13c856df70a9-6f9d-4223-ae36-6ebfda21b350311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>56df70a9-6f9d-4223-ae36-6ebfda21b350</b:FlowGuid><b:Id>13</b:Id><b:InteractionKey>241166ce-6cfd-4969-9002-c2cd244c13c8:56df70a9-6f9d-4223-ae36-6ebfda21b350:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:51:29.5006005+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  claims that it did not receive data from a source outside the trust boundary. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mitigated by FR-SYS-05 (append-only audit log): AuditLogger records every login attempt before the result is returned to the caller — both failed attempts (WARN: BAD_INPUT, BAD_PASSWORD, NO_SUCH_USER, BLOCKED_LOCKED) and successful logins (INFO: LOGIN OK) — with a precise timestamp and the username that was submitted. Even if process 1.1 Validate Input were to "claim" it did not receive the Login Credentials, the audit entry already written to audit.log with StandardOpenOption.APPEND constitutes a permanent, irrefutable record of the attempt. No application operation can delete or truncate this file.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>241166ce-6cfd-4969-9002-c2cd244c13c8</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3241166ce-6cfd-4969-9002-c2cd244c13c856df70a9-6f9d-4223-ae36-6ebfda21b350311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>56df70a9-6f9d-4223-ae36-6ebfda21b350</b:FlowGuid><b:Id>14</b:Id><b:InteractionKey>241166ce-6cfd-4969-9002-c2cd244c13c8:56df70a9-6f9d-4223-ae36-6ebfda21b350:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:54:22.0043983+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Same mitigation as ID 6: pure-function input validation cannot crash. Any unexpected exception is caught by the top-level App.main() catch(Throwable) and logged via AuditLogger. The application either continues normally or exits cleanly — no inconsistent state.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>241166ce-6cfd-4969-9002-c2cd244c13c8</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4241166ce-6cfd-4969-9002-c2cd244c13c856df70a9-6f9d-4223-ae36-6ebfda21b350311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>56df70a9-6f9d-4223-ae36-6ebfda21b350</b:FlowGuid><b:Id>15</b:Id><b:InteractionKey>241166ce-6cfd-4969-9002-c2cd244c13c8:56df70a9-6f9d-4223-ae36-6ebfda21b350:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:54:25.3753013+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Login Credentials Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Login Credentials data flow is entirely in-process: the credential string travels from Scanner(System.in) to AuthService.login() as a method argument within the same JVM thread. There is no network socket, no inter-process pipe, and no message queue that an external agent could interrupt. If the user closes the console terminal mid-input, Scanner.nextLine() throws NoSuchElementException, which is caught by the top-level catch(Throwable) in App.main() and logged to audit.log before the process exits cleanly — no inconsistent state is left.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>241166ce-6cfd-4969-9002-c2cd244c13c8</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5241166ce-6cfd-4969-9002-c2cd244c13c856df70a9-6f9d-4223-ae36-6ebfda21b350311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>56df70a9-6f9d-4223-ae36-6ebfda21b350</b:FlowGuid><b:Id>16</b:Id><b:InteractionKey>241166ce-6cfd-4969-9002-c2cd244c13c8:56df70a9-6f9d-4223-ae36-6ebfda21b350:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:55:20.3774077+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  may be able to impersonate the context of Dispatcher in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Same as ID 8: PBKDF2 password verification + role enum read from users.dat on every login. A Dispatcher cannot be impersonated without their password. Even if compromised, a Dispatcher account does not have admin privileges (Least Privilege).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>241166ce-6cfd-4969-9002-c2cd244c13c8</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6241166ce-6cfd-4969-9002-c2cd244c13c856df70a9-6f9d-4223-ae36-6ebfda21b350311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>56df70a9-6f9d-4223-ae36-6ebfda21b350</b:FlowGuid><b:Id>17</b:Id><b:InteractionKey>241166ce-6cfd-4969-9002-c2cd244c13c8:56df70a9-6f9d-4223-ae36-6ebfda21b350:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:55:27.7349465+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>1.1 Validate Input  May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Dispatcher may be able to remotely execute code for 1.1 Validate Input .</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>ShipTrack is a console-only application with no network listener, no HTTP endpoint, no RPC interface, and no deserialization of untrusted objects. The only input channel into process 1.1 Validate Input is Scanner(System.in) reading plain text. Remote code execution requires a remote channel — none exists. InputValidator performs only regex matching; no eval(), exec(), Runtime.exec(), or reflection on user input occurs anywhere in the codebase.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>241166ce-6cfd-4969-9002-c2cd244c13c8</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7241166ce-6cfd-4969-9002-c2cd244c13c856df70a9-6f9d-4223-ae36-6ebfda21b350311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>56df70a9-6f9d-4223-ae36-6ebfda21b350</b:FlowGuid><b:Id>18</b:Id><b:InteractionKey>241166ce-6cfd-4969-9002-c2cd244c13c8:56df70a9-6f9d-4223-ae36-6ebfda21b350:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:55:31.8668676+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 1.1 Validate Input  in order to change the flow of program execution within 1.1 Validate Input  to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>InputValidator.isValidUsername() applies the regex ^[A-Za-z0-9._-]{3,20}$ against the input and returns true or false — there is no code path that an attacker can branch into. The method contains no conditional logic driven by input content beyond the single regex match. SEC-INP-01 enforces a strict allow-list approach: anything not matching the pattern is rejected immediately before it reaches any other code. There is no injection vector, no buffer overflow, and no format-string vulnerability in a pure regex operation.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>241166ce-6cfd-4969-9002-c2cd244c13c8</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261241166ce-6cfd-4969-9002-c2cd244c13c856df70a9-6f9d-4223-ae36-6ebfda21b350311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>56df70a9-6f9d-4223-ae36-6ebfda21b350</b:FlowGuid><b:Id>19</b:Id><b:InteractionKey>241166ce-6cfd-4969-9002-c2cd244c13c8:56df70a9-6f9d-4223-ae36-6ebfda21b350:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:57:17.0807185+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting. The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Not applicable. ShipTrack is a console application. It has no HTTP server, no browser interface, no session cookies, no cross-origin contexts, and no web forms. CSRF is architecturally impossible because there is no browser and no stateful HTTP session that a forged request could exploit. The attack surface described by this threat category does not exist in this system. This threat is generated generically by the tool for all external-entity-to-process flows; it does not apply to console-only desktop applications.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Deleted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>241166ce-6cfd-4969-9002-c2cd244c13c8</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S3955ecc6a-ad90-4b29-9706-4184c7e77fe410dd1c7a-0b92-490b-9144-7eae3cef947d311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>10dd1c7a-0b92-490b-9144-7eae3cef947d</b:FlowGuid><b:Id>20</b:Id><b:InteractionKey>955ecc6a-ad90-4b29-9706-4184c7e77fe4:10dd1c7a-0b92-490b-9144-7eae3cef947d:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:47:05.1929719+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Delivery Personnel  External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Delivery Personnel  may be spoofed by an attacker and this may lead to unauthorized access to 1.1 Validate Input . </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>PBKDF2 verification prevents login spoofing. Additionally, even if a Driver account were compromised, SEC-LOCK-04 Least Privilege ensures the attacker can only update shipments assigned to that specific driver — DriverMenu.updateStatus() checks me.getUsername().equals(s.getDriverUsername()) on every call.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6955ecc6a-ad90-4b29-9706-4184c7e77fe410dd1c7a-0b92-490b-9144-7eae3cef947d311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>10dd1c7a-0b92-490b-9144-7eae3cef947d</b:FlowGuid><b:Id>21</b:Id><b:InteractionKey>955ecc6a-ad90-4b29-9706-4184c7e77fe4:10dd1c7a-0b92-490b-9144-7eae3cef947d:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3955ecc6a-ad90-4b29-9706-4184c7e77fe410dd1c7a-0b92-490b-9144-7eae3cef947d311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>10dd1c7a-0b92-490b-9144-7eae3cef947d</b:FlowGuid><b:Id>22</b:Id><b:InteractionKey>955ecc6a-ad90-4b29-9706-4184c7e77fe4:10dd1c7a-0b92-490b-9144-7eae3cef947d:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:54:27.8531533+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Validate Input process is shared across all four login paths. The same Fail Securely protections apply. Input validation logic uses no resources beyond regex matching on bounded-length input strings (Scanner.nextLine() respects buffer limits).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4955ecc6a-ad90-4b29-9706-4184c7e77fe410dd1c7a-0b92-490b-9144-7eae3cef947d311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>10dd1c7a-0b92-490b-9144-7eae3cef947d</b:FlowGuid><b:Id>23</b:Id><b:InteractionKey>955ecc6a-ad90-4b29-9706-4184c7e77fe4:10dd1c7a-0b92-490b-9144-7eae3cef947d:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:54:30.5176432+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Login Credentials Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Same mitigation as ID 15: Login Credentials flow is in-process within the JVM. Scanner.nextLine() returns only a complete line — there is no partial credential that could be delivered to authentication logic. A console disconnect is handled by the top-level catch(Throwable) in App.main(). Because no partial credential reaches AuthService.login(), no authentication attempt is partially evaluated and no security state is left inconsistent.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5955ecc6a-ad90-4b29-9706-4184c7e77fe410dd1c7a-0b92-490b-9144-7eae3cef947d311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>10dd1c7a-0b92-490b-9144-7eae3cef947d</b:FlowGuid><b:Id>24</b:Id><b:InteractionKey>955ecc6a-ad90-4b29-9706-4184c7e77fe4:10dd1c7a-0b92-490b-9144-7eae3cef947d:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:55:34.2747432+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  may be able to impersonate the context of Delivery Personnel  in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mitigated by SEC-LOCK-03 (Role-Based Menu Dispatch): the role assigned to any logged-in user is read directly from users.dat at login time and is immutable for the duration of that session. App.java's switch(u.getRole()) constructs exactly one menu object — DriverMenu for DELIVERY_PERSONNEL — and no other code is reachable from that session. Process 1.1 Validate Input has no mechanism to elevate itself to another context; it simply calls InputValidator.isValidUsername() and returns. Role assignment is controlled exclusively by the System Admin through AdminMenu (a separate code path).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6955ecc6a-ad90-4b29-9706-4184c7e77fe410dd1c7a-0b92-490b-9144-7eae3cef947d311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>10dd1c7a-0b92-490b-9144-7eae3cef947d</b:FlowGuid><b:Id>25</b:Id><b:InteractionKey>955ecc6a-ad90-4b29-9706-4184c7e77fe4:10dd1c7a-0b92-490b-9144-7eae3cef947d:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:55:36.5225272+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>1.1 Validate Input  May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Delivery Personnel  may be able to remotely execute code for 1.1 Validate Input .</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Same mitigation as ID 17: ShipTrack has no remote execution attack surface. It is a console-only application. Process 1.1 Validate Input executes InputValidator.isValidUsername() — a regex match — against a string read from System.in. There is no mechanism by which Delivery Personnel or any other entity could cause remote code to run inside this process. The application has zero network-facing interfaces.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7955ecc6a-ad90-4b29-9706-4184c7e77fe410dd1c7a-0b92-490b-9144-7eae3cef947d311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>10dd1c7a-0b92-490b-9144-7eae3cef947d</b:FlowGuid><b:Id>26</b:Id><b:InteractionKey>955ecc6a-ad90-4b29-9706-4184c7e77fe4:10dd1c7a-0b92-490b-9144-7eae3cef947d:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:55:39.0803349+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 1.1 Validate Input  in order to change the flow of program execution within 1.1 Validate Input  to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Same mitigation as ID 18: InputValidator methods are pure regex validators with a single possible branch — accept or reject. There is no dynamic dispatch, no reflection, no deserialization, and no input-driven code selection. SEC-INP-01's strict allow-list (^[A-Za-z0-9._-]{3,20}$) means any attempt to inject control-flow-altering content (pipe characters, null bytes, escape sequences, path traversal strings) is rejected at the very first check before any processing occurs.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261955ecc6a-ad90-4b29-9706-4184c7e77fe410dd1c7a-0b92-490b-9144-7eae3cef947d311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>10dd1c7a-0b92-490b-9144-7eae3cef947d</b:FlowGuid><b:Id>27</b:Id><b:InteractionKey>955ecc6a-ad90-4b29-9706-4184c7e77fe4:10dd1c7a-0b92-490b-9144-7eae3cef947d:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:56:45.8003778+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting. The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value> CSRF is a web-specific attack that requires a browser, HTTP cookies or session tokens, and a cross-origin request mechanism — none of which exist in this system. ShipTrack is a console-only Java application that reads input exclusively from Scanner(System.in) and has no HTTP server, no web interface, no browser sessions, no cookies, and no cross-site context of any kind. The attack described requires a browser to automatically carry a credential (cookie or integrated auth token) to a vulnerable web endpoint when tricked into visiting an attacker-controlled site — this precondition is architecturally impossible in a console application. This threat is generated generically by the Microsoft Threat Modeling Tool for all external-entity-to-process data flows regardless of application type. It does not apply here. The correct mitigation is to mark it as Not Applicable in environments that use the tool's state dropdown, or Mitigated by architecture as documented here.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S371c65a5f-28a9-403d-a124-c646172ac37a6be21b04-e6e6-4271-8b19-55554472645c311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6be21b04-e6e6-4271-8b19-55554472645c</b:FlowGuid><b:Id>28</b:Id><b:InteractionKey>71c65a5f-28a9-403d-a124-c646172ac37a:6be21b04-e6e6-4271-8b19-55554472645c:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:46:29.5490381+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the System Admin External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>System Admin may be spoofed by an attacker and this may lead to unauthorized access to 1.1 Validate Input . </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>PBKDF2 verification + SEC-DATA-04: the default admin password (Admin@123) MUST be changed on first login — AdminMenu.forcePasswordChange() auto-triggers when the default credential is detected. Combined with account lockout (max 3 failed attempts → permanent lock), brute-forcing an Admin password is infeasible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71c65a5f-28a9-403d-a124-c646172ac37a</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R671c65a5f-28a9-403d-a124-c646172ac37a6be21b04-e6e6-4271-8b19-55554472645c311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6be21b04-e6e6-4271-8b19-55554472645c</b:FlowGuid><b:Id>29</b:Id><b:InteractionKey>71c65a5f-28a9-403d-a124-c646172ac37a:6be21b04-e6e6-4271-8b19-55554472645c:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71c65a5f-28a9-403d-a124-c646172ac37a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D371c65a5f-28a9-403d-a124-c646172ac37a6be21b04-e6e6-4271-8b19-55554472645c311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6be21b04-e6e6-4271-8b19-55554472645c</b:FlowGuid><b:Id>30</b:Id><b:InteractionKey>71c65a5f-28a9-403d-a124-c646172ac37a:6be21b04-e6e6-4271-8b19-55554472645c:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:54:33.4381962+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>InputValidator.isValidUsername() and isStorageSafe() are pure functions: they perform only regex matching on the input string and return a boolean. They have no I/O, no heap allocations beyond the regex engine, and no external dependencies that could fail. They cannot crash from external causes. Any RuntimeException that does propagate is caught by AuthService.login()'s surrounding try/catch, and any Throwable that reaches the top level is caught by App.main()'s catch(Throwable) which logs the error to audit.log before exiting cleanly. The application never enters an inconsistent state.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71c65a5f-28a9-403d-a124-c646172ac37a</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D471c65a5f-28a9-403d-a124-c646172ac37a6be21b04-e6e6-4271-8b19-55554472645c311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6be21b04-e6e6-4271-8b19-55554472645c</b:FlowGuid><b:Id>31</b:Id><b:InteractionKey>71c65a5f-28a9-403d-a124-c646172ac37a:6be21b04-e6e6-4271-8b19-55554472645c:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Login Credentials Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71c65a5f-28a9-403d-a124-c646172ac37a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E571c65a5f-28a9-403d-a124-c646172ac37a6be21b04-e6e6-4271-8b19-55554472645c311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6be21b04-e6e6-4271-8b19-55554472645c</b:FlowGuid><b:Id>32</b:Id><b:InteractionKey>71c65a5f-28a9-403d-a124-c646172ac37a:6be21b04-e6e6-4271-8b19-55554472645c:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  may be able to impersonate the context of System Admin in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71c65a5f-28a9-403d-a124-c646172ac37a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E671c65a5f-28a9-403d-a124-c646172ac37a6be21b04-e6e6-4271-8b19-55554472645c311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6be21b04-e6e6-4271-8b19-55554472645c</b:FlowGuid><b:Id>33</b:Id><b:InteractionKey>71c65a5f-28a9-403d-a124-c646172ac37a:6be21b04-e6e6-4271-8b19-55554472645c:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>1.1 Validate Input  May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>System Admin may be able to remotely execute code for 1.1 Validate Input .</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71c65a5f-28a9-403d-a124-c646172ac37a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E771c65a5f-28a9-403d-a124-c646172ac37a6be21b04-e6e6-4271-8b19-55554472645c311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6be21b04-e6e6-4271-8b19-55554472645c</b:FlowGuid><b:Id>34</b:Id><b:InteractionKey>71c65a5f-28a9-403d-a124-c646172ac37a:6be21b04-e6e6-4271-8b19-55554472645c:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 1.1 Validate Input  in order to change the flow of program execution within 1.1 Validate Input  to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71c65a5f-28a9-403d-a124-c646172ac37a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b026171c65a5f-28a9-403d-a124-c646172ac37a6be21b04-e6e6-4271-8b19-55554472645c311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6be21b04-e6e6-4271-8b19-55554472645c</b:FlowGuid><b:Id>35</b:Id><b:InteractionKey>71c65a5f-28a9-403d-a124-c646172ac37a:6be21b04-e6e6-4271-8b19-55554472645c:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting. The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71c65a5f-28a9-403d-a124-c646172ac37a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8fed27f0d-037b-4f19-b08a-d230baa39b4ea01eb0b9-9d36-4aec-ae07-47df41043f6a300fef01-3e35-4607-9161-0616ee4df07e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>a01eb0b9-9d36-4aec-ae07-47df41043f6a</b:FlowGuid><b:Id>36</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:a01eb0b9-9d36-4aec-ae07-47df41043f6a:300fef01-3e35-4607-9161-0616ee4df07e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:48:45.4140731+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the Customer External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Customer may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of Customer. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Authentication Result is delivered as an in-process method return value from AuthService back to App.java within the same JVM, not over a network. There is no remote message channel that an attacker could spoof. The destination Customer is the same console session that initiated the login.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7fed27f0d-037b-4f19-b08a-d230baa39b4ea01eb0b9-9d36-4aec-ae07-47df41043f6a300fef01-3e35-4607-9161-0616ee4df07e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>a01eb0b9-9d36-4aec-ae07-47df41043f6a</b:FlowGuid><b:Id>37</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:a01eb0b9-9d36-4aec-ae07-47df41043f6a:300fef01-3e35-4607-9161-0616ee4df07e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:51:36.4054235+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity Customer Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Customer claims that it did not receive data from a process on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>AuditLogger records every action initiated by the Customer (LOGIN, CREATE_SHIPMENT, UPDATE_PROFILE, REGISTER_CUSTOMER) with timestamp and username. The customer cannot deny they performed these actions — the action history is non-repudiable from the system's records.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4fed27f0d-037b-4f19-b08a-d230baa39b4ea01eb0b9-9d36-4aec-ae07-47df41043f6a300fef01-3e35-4607-9161-0616ee4df07e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>a01eb0b9-9d36-4aec-ae07-47df41043f6a</b:FlowGuid><b:Id>38</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:a01eb0b9-9d36-4aec-ae07-47df41043f6a:300fef01-3e35-4607-9161-0616ee4df07e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:54:35.7715439+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Authentication Result Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Authentication Result is an in-process method return from AuthService.login() to App.doLogin(). No network interruption possible. If the user closes the console mid-response, the session ends with no security consequence — the audit entry for the attempt was written before the result was returned.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8fed27f0d-037b-4f19-b08a-d230baa39b4eb0bf8817-f58e-44b1-bcf1-be81920f2f42241166ce-6cfd-4969-9002-c2cd244c13c8</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>b0bf8817-f58e-44b1-bcf1-be81920f2f42</b:FlowGuid><b:Id>39</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:b0bf8817-f58e-44b1-bcf1-be81920f2f42:241166ce-6cfd-4969-9002-c2cd244c13c8</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:48:12.6680709+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the Dispatcher External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Dispatcher may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of Dispatcher. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Same as ID 36: the Authentication Result is an in-process method return, not a network message. The recipient is the same console session that authenticated. No spoofable channel exists in a console-only application.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>241166ce-6cfd-4969-9002-c2cd244c13c8</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7fed27f0d-037b-4f19-b08a-d230baa39b4eb0bf8817-f58e-44b1-bcf1-be81920f2f42241166ce-6cfd-4969-9002-c2cd244c13c8</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>b0bf8817-f58e-44b1-bcf1-be81920f2f42</b:FlowGuid><b:Id>40</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:b0bf8817-f58e-44b1-bcf1-be81920f2f42:241166ce-6cfd-4969-9002-c2cd244c13c8</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:51:43.4953712+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity Dispatcher Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Dispatcher claims that it did not receive data from a process on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>All Dispatcher actions (LOGIN, ASSIGN_DELIVERY, UPDATE_STATUS, UPDATE_PROFILE) are logged to audit.log with timestamp and username via AuditLogger. The Dispatcher's actions are non-repudiable from the system's records.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>241166ce-6cfd-4969-9002-c2cd244c13c8</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4fed27f0d-037b-4f19-b08a-d230baa39b4eb0bf8817-f58e-44b1-bcf1-be81920f2f42241166ce-6cfd-4969-9002-c2cd244c13c8</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>b0bf8817-f58e-44b1-bcf1-be81920f2f42</b:FlowGuid><b:Id>41</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:b0bf8817-f58e-44b1-bcf1-be81920f2f42:241166ce-6cfd-4969-9002-c2cd244c13c8</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Authentication Result Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>241166ce-6cfd-4969-9002-c2cd244c13c8</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8fed27f0d-037b-4f19-b08a-d230baa39b4e4f7cee94-f25b-480f-a17d-67671beb772b955ecc6a-ad90-4b29-9706-4184c7e77fe4</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>4f7cee94-f25b-480f-a17d-67671beb772b</b:FlowGuid><b:Id>42</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:4f7cee94-f25b-480f-a17d-67671beb772b:955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:48:34.2132237+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the Delivery Personnel  External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Delivery Personnel  may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of Delivery Personnel . </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Authentication Result is delivered as an in-process method return value from AuthService.login() back to App.doLogin() within the same JVM — it is never sent over a network channel. The destination Delivery Personnel is the same console session that typed the credentials. There is no intermediate network hop or message broker that an attacker could intercept or substitute. Additionally, even if a Driver's credentials were stolen, DriverMenu.updateStatus() enforces a per-shipment ownership check (me.getUsername().equals(s.getDriverUsername())) on every call, limiting the damage to only that specific driver's assigned shipments</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7fed27f0d-037b-4f19-b08a-d230baa39b4e4f7cee94-f25b-480f-a17d-67671beb772b955ecc6a-ad90-4b29-9706-4184c7e77fe4</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>4f7cee94-f25b-480f-a17d-67671beb772b</b:FlowGuid><b:Id>43</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:4f7cee94-f25b-480f-a17d-67671beb772b:955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:51:49.6073587+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity Delivery Personnel  Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Delivery Personnel  claims that it did not receive data from a process on the other side of the trust boundary. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Driver actions are logged to audit.log. Importantly, attempts to update shipments NOT assigned to the driver are recorded with AuditLogger.warn() as "UPDATE_STATUS DENIED [shipmentID]" — capturing both legitimate and attempted illegitimate actions for non-repudiation.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4fed27f0d-037b-4f19-b08a-d230baa39b4e4f7cee94-f25b-480f-a17d-67671beb772b955ecc6a-ad90-4b29-9706-4184c7e77fe4</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>4f7cee94-f25b-480f-a17d-67671beb772b</b:FlowGuid><b:Id>44</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:4f7cee94-f25b-480f-a17d-67671beb772b:955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Authentication Result Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>955ecc6a-ad90-4b29-9706-4184c7e77fe4</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S8fed27f0d-037b-4f19-b08a-d230baa39b4e75df4260-52f9-4392-ade2-748480a7b7ae71c65a5f-28a9-403d-a124-c646172ac37a</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>75df4260-52f9-4392-ade2-748480a7b7ae</b:FlowGuid><b:Id>45</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:75df4260-52f9-4392-ade2-748480a7b7ae:71c65a5f-28a9-403d-a124-c646172ac37a</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:48:05.8539786+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of the System Admin External Destination Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>System Admin may be spoofed by an attacker and this may lead to data being sent to the attacker's target instead of System Admin. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Authentication Result is an in-process method return within the same JVM — no network channel exists that could redirect it to an attacker. Beyond that, AdminMenu.run() applies SEC-DATA-04: on first login it detects whether the default password is still in use via PasswordHasher.verify(Constants.DEFAULT_ADMIN_PASSWORD, ...) and forces forcePasswordChange() before displaying any menu option. This eliminates the most common admin-spoofing vector — unchanged default credentials. Account lockout after maxLoginAttempts failures (default 3) prevents brute-force attempts against the Admin account.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71c65a5f-28a9-403d-a124-c646172ac37a</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R7fed27f0d-037b-4f19-b08a-d230baa39b4e75df4260-52f9-4392-ade2-748480a7b7ae71c65a5f-28a9-403d-a124-c646172ac37a</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>75df4260-52f9-4392-ade2-748480a7b7ae</b:FlowGuid><b:Id>46</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:75df4260-52f9-4392-ade2-748480a7b7ae:71c65a5f-28a9-403d-a124-c646172ac37a</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:51:54.6290817+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>External Entity System Admin Potentially Denies Receiving Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>System Admin claims that it did not receive data from a process on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>All Admin actions are logged: REGISTER_DISPATCHER, REGISTER_DELIVERY_PERSONNEL, REMOVE_USER, LOCK_ACCOUNT, UNLOCK_ACCOUNT, POLICY_UPDATE, MAX_ATTEMPTS_UPDATE, CHANGE_PASSWORD — each with timestamp and admin username. The Admin cannot deny any administrative action.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71c65a5f-28a9-403d-a124-c646172ac37a</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4fed27f0d-037b-4f19-b08a-d230baa39b4e75df4260-52f9-4392-ade2-748480a7b7ae71c65a5f-28a9-403d-a124-c646172ac37a</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>75df4260-52f9-4392-ade2-748480a7b7ae</b:FlowGuid><b:Id>47</b:Id><b:InteractionKey>fed27f0d-037b-4f19-b08a-d230baa39b4e:75df4260-52f9-4392-ade2-748480a7b7ae:71c65a5f-28a9-403d-a124-c646172ac37a</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Authentication Result Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71c65a5f-28a9-403d-a124-c646172ac37a</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5311471d4-ba17-4555-9b3e-9529fac83423357ab254-73f9-4d18-b872-aeb3ab9c3b011239d856-c2f6-4d21-9787-b3041a21c68e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>357ab254-73f9-4d18-b872-aeb3ab9c3b01</b:FlowGuid><b:Id>48</b:Id><b:InteractionKey>311471d4-ba17-4555-9b3e-9529fac83423:357ab254-73f9-4d18-b872-aeb3ab9c3b01:1239d856-c2f6-4d21-9787-b3041a21c68e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.2 Verify PBKDF2 Password  may be able to impersonate the context of 1.1 Validate Input  in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Validated Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E51239d856-c2f6-4d21-9787-b3041a21c68e6519061f-e70a-47e1-8e8c-004098b7a4b55002f26b-5ee1-4d13-8b94-50a17485b726</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6519061f-e70a-47e1-8e8c-004098b7a4b5</b:FlowGuid><b:Id>49</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:6519061f-e70a-47e1-8e8c-004098b7a4b5:5002f26b-5ee1-4d13-8b94-50a17485b726</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.3 Check Account Lockout  may be able to impersonate the context of 1.2 Verify PBKDF2 Password  in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credential Check Result</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E55002f26b-5ee1-4d13-8b94-50a17485b726b4db6207-43cb-49e0-8fd0-1990149150ec9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>b4db6207-43cb-49e0-8fd0-1990149150ec</b:FlowGuid><b:Id>50</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:b4db6207-43cb-49e0-8fd0-1990149150ec:9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.4 Manage Attempt Counter may be able to impersonate the context of 1.3 Check Account Lockout  in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Lockout Decision</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E59f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6b00f4f53-6607-4cb1-ace5-71a69cf9bb9cfed27f0d-037b-4f19-b08a-d230baa39b4e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>b00f4f53-6607-4cb1-ace5-71a69cf9bb9c</b:FlowGuid><b:Id>51</b:Id><b:InteractionKey>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6:b00f4f53-6607-4cb1-ace5-71a69cf9bb9c:fed27f0d-037b-4f19-b08a-d230baa39b4e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:57:07.570842+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.5 Dispatch to Role Menu may be able to impersonate the context of 1.4 Manage Attempt Counter in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Process 1.5 Dispatch to Role Menu and process 1.4 Manage Attempt Counter are not separate programs or services — they are sequential steps inside the same method AuthService.login() executing within a single JVM thread. The "Authentication Decision" data flowing from 1.4 to 1.5 is a local method return value passed on the call stack, not a message over any channel. There is no operating system boundary, no process boundary, no socket, and no shared memory region between them that an attacker could intercept or substitute. Impersonation of one process by another requires a boundary that can be crossed — no such boundary exists here.
Furthermore, the Authentication Decision produced by 1.4 Manage Attempt Counter carries only a boolean outcome (success or failure) and the authenticated User object read from users.dat. Process 1.5 does not grant any privilege itself — it only calls switch(u.getRole()) on the User object whose role was read directly from disk. Even if 1.5 were somehow substituted, it has no independent privilege to grant — all access control is derived from the role field already committed to users.dat by the System Admin. The role cannot be changed by any operation available to 1.4 or 1.5</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Authentication Decision</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fed27f0d-037b-4f19-b08a-d230baa39b4e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7544d07d9-cb53-40b4-b25c-8df548357be54e79754c-c319-4cc4-a577-5a4d74bee2e21239d856-c2f6-4d21-9787-b3041a21c68e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>4e79754c-c319-4cc4-a577-5a4d74bee2e2</b:FlowGuid><b:Id>59</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:4e79754c-c319-4cc4-a577-5a4d74bee2e2:1239d856-c2f6-4d21-9787-b3041a21c68e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:48:55.7741649+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store users.dat </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>users.dat  may be spoofed by an attacker and this may lead to incorrect data delivered to 1.2 Verify PBKDF2 Password . </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>users.dat is a local file on the same filesystem as the application. Its path is hardcoded as data/users.dat in Constants.java — there is no configuration that could redirect reads to a different location. The flow users.dat → 1.2 Verify PBKDF2 Password is an in-process Files.readAllLines() call; no network path exists that an attacker could substitute with a spoofed source. OS file-system permissions (operational control) ensure only the application process can read the file. If the file were replaced with a crafted one, the PBKDF2 hashes inside would still need to match the user's real password — an attacker gains nothing without also knowing the plaintexts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Stored Hash, Salt, Role</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6544d07d9-cb53-40b4-b25c-8df548357be54e79754c-c319-4cc4-a577-5a4d74bee2e21239d856-c2f6-4d21-9787-b3041a21c68e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>4e79754c-c319-4cc4-a577-5a4d74bee2e2</b:FlowGuid><b:Id>60</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:4e79754c-c319-4cc4-a577-5a4d74bee2e2:1239d856-c2f6-4d21-9787-b3041a21c68e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:52:00.4071076+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 1.2 Verify PBKDF2 Password </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.2 Verify PBKDF2 Password  claims that it did not receive data from a source outside the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>PasswordHasher.verify() is a pure function. The DECISION it produces (true/false) is captured by the calling AuthService.login(), which writes the audit entry (LOGIN OK or LOGIN BAD_PASSWORD with attempt=N). The verification outcome cannot be denied because it is observable in the audit log.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Stored Hash, Salt, Role</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23544d07d9-cb53-40b4-b25c-8df548357be54e79754c-c319-4cc4-a577-5a4d74bee2e21239d856-c2f6-4d21-9787-b3041a21c68e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>4e79754c-c319-4cc4-a577-5a4d74bee2e2</b:FlowGuid><b:Id>61</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:4e79754c-c319-4cc4-a577-5a4d74bee2e2:1239d856-c2f6-4d21-9787-b3041a21c68e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:52:55.9047853+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of users.dat  can allow an attacker to read information not intended for disclosure.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mitigated by SEC-AUTH-02 + Secrets Are Not Kept (Ch.2): users.dat stores only the PBKDF2-derived hash and per-user salt, never plaintext passwords. Even if an attacker reads the file, recovering plaintext passwords requires running 65,536 PBKDF2 iterations per guess — infeasible for strong passwords. The unique salt prevents rainbow-table attacks.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Stored Hash, Salt, Role</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3544d07d9-cb53-40b4-b25c-8df548357be54e79754c-c319-4cc4-a577-5a4d74bee2e21239d856-c2f6-4d21-9787-b3041a21c68e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>4e79754c-c319-4cc4-a577-5a4d74bee2e2</b:FlowGuid><b:Id>62</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:4e79754c-c319-4cc4-a577-5a4d74bee2e2:1239d856-c2f6-4d21-9787-b3041a21c68e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:54:38.5891303+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 1.2 Verify PBKDF2 Password </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.2 Verify PBKDF2 Password  crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>PasswordHasher.verify() catches GeneralSecurityException and IllegalArgumentException internally and returns false — it cannot crash the caller. Any other Throwable is caught by App.main()'s top-level catch(Throwable). The lockout mechanism limits attack-induced load (SEC-LOCK-01).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Stored Hash, Salt, Role</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4544d07d9-cb53-40b4-b25c-8df548357be54e79754c-c319-4cc4-a577-5a4d74bee2e21239d856-c2f6-4d21-9787-b3041a21c68e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>4e79754c-c319-4cc4-a577-5a4d74bee2e2</b:FlowGuid><b:Id>63</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:4e79754c-c319-4cc4-a577-5a4d74bee2e2:1239d856-c2f6-4d21-9787-b3041a21c68e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:54:42.3490619+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Stored Hash, Salt, Role Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>In-process Files.readAllLines() return value — cannot be interrupted by an external attacker. If the read fails (disk error), the exception propagates and the login attempt fails closed. No partial data is ever processed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Stored Hash, Salt, Role</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5544d07d9-cb53-40b4-b25c-8df548357be54e79754c-c319-4cc4-a577-5a4d74bee2e21239d856-c2f6-4d21-9787-b3041a21c68e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>4e79754c-c319-4cc4-a577-5a4d74bee2e2</b:FlowGuid><b:Id>64</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:4e79754c-c319-4cc4-a577-5a4d74bee2e2:1239d856-c2f6-4d21-9787-b3041a21c68e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Stored Hash, Salt, Role</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6544d07d9-cb53-40b4-b25c-8df548357be54e79754c-c319-4cc4-a577-5a4d74bee2e21239d856-c2f6-4d21-9787-b3041a21c68e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>4e79754c-c319-4cc4-a577-5a4d74bee2e2</b:FlowGuid><b:Id>65</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:4e79754c-c319-4cc4-a577-5a4d74bee2e2:1239d856-c2f6-4d21-9787-b3041a21c68e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>1.2 Verify PBKDF2 Password  May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>users.dat  may be able to remotely execute code for 1.2 Verify PBKDF2 Password .</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Stored Hash, Salt, Role</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7544d07d9-cb53-40b4-b25c-8df548357be54e79754c-c319-4cc4-a577-5a4d74bee2e21239d856-c2f6-4d21-9787-b3041a21c68e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>4e79754c-c319-4cc4-a577-5a4d74bee2e2</b:FlowGuid><b:Id>66</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:4e79754c-c319-4cc4-a577-5a4d74bee2e2:1239d856-c2f6-4d21-9787-b3041a21c68e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 1.2 Verify PBKDF2 Password </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 1.2 Verify PBKDF2 Password  in order to change the flow of program execution within 1.2 Verify PBKDF2 Password  to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Stored Hash, Salt, Role</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7544d07d9-cb53-40b4-b25c-8df548357be58063418a-4890-4f99-955c-69eb4d63ddfd5002f26b-5ee1-4d13-8b94-50a17485b726</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>8063418a-4890-4f99-955c-69eb4d63ddfd</b:FlowGuid><b:Id>74</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:8063418a-4890-4f99-955c-69eb4d63ddfd:5002f26b-5ee1-4d13-8b94-50a17485b726</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store users.dat </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>users.dat  may be spoofed by an attacker and this may lead to incorrect data delivered to 1.3 Check Account Lockout . Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Lock Flag and Failed Attempts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6544d07d9-cb53-40b4-b25c-8df548357be58063418a-4890-4f99-955c-69eb4d63ddfd5002f26b-5ee1-4d13-8b94-50a17485b726</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>8063418a-4890-4f99-955c-69eb4d63ddfd</b:FlowGuid><b:Id>75</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:8063418a-4890-4f99-955c-69eb4d63ddfd:5002f26b-5ee1-4d13-8b94-50a17485b726</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:52:05.7699683+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 1.3 Check Account Lockout </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.3 Check Account Lockout  claims that it did not receive data from a source outside the trust boundary. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Account lock events are explicitly logged: AuditLogger.warn(username, "LOGIN", "BLOCKED_LOCKED") when a locked account attempts to log in, and AuditLogger.warn(username, "LOGIN", "LOCKED_AFTER_ATTEMPTS") when the lock is triggered. Both events include the timestamp and username.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Lock Flag and Failed Attempts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23544d07d9-cb53-40b4-b25c-8df548357be58063418a-4890-4f99-955c-69eb4d63ddfd5002f26b-5ee1-4d13-8b94-50a17485b726</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>8063418a-4890-4f99-955c-69eb4d63ddfd</b:FlowGuid><b:Id>76</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:8063418a-4890-4f99-955c-69eb4d63ddfd:5002f26b-5ee1-4d13-8b94-50a17485b726</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:53:00.7268548+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of users.dat  can allow an attacker to read information not intended for disclosure. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The lock flag and failed-attempts counter are operational metadata, not sensitive data. They reveal only whether an account is currently locked — information the legitimate user already observes when attempting to log in. OS file-system permissions on users.dat limit who can read the file (operational control).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Lock Flag and Failed Attempts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3544d07d9-cb53-40b4-b25c-8df548357be58063418a-4890-4f99-955c-69eb4d63ddfd5002f26b-5ee1-4d13-8b94-50a17485b726</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>8063418a-4890-4f99-955c-69eb4d63ddfd</b:FlowGuid><b:Id>77</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:8063418a-4890-4f99-955c-69eb4d63ddfd:5002f26b-5ee1-4d13-8b94-50a17485b726</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 1.3 Check Account Lockout </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.3 Check Account Lockout  crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Lock Flag and Failed Attempts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4544d07d9-cb53-40b4-b25c-8df548357be58063418a-4890-4f99-955c-69eb4d63ddfd5002f26b-5ee1-4d13-8b94-50a17485b726</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>8063418a-4890-4f99-955c-69eb4d63ddfd</b:FlowGuid><b:Id>78</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:8063418a-4890-4f99-955c-69eb4d63ddfd:5002f26b-5ee1-4d13-8b94-50a17485b726</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Lock Flag and Failed Attempts Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Lock Flag and Failed Attempts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5544d07d9-cb53-40b4-b25c-8df548357be58063418a-4890-4f99-955c-69eb4d63ddfd5002f26b-5ee1-4d13-8b94-50a17485b726</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>8063418a-4890-4f99-955c-69eb4d63ddfd</b:FlowGuid><b:Id>79</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:8063418a-4890-4f99-955c-69eb4d63ddfd:5002f26b-5ee1-4d13-8b94-50a17485b726</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Lock Flag and Failed Attempts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6544d07d9-cb53-40b4-b25c-8df548357be58063418a-4890-4f99-955c-69eb4d63ddfd5002f26b-5ee1-4d13-8b94-50a17485b726</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>8063418a-4890-4f99-955c-69eb4d63ddfd</b:FlowGuid><b:Id>80</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:8063418a-4890-4f99-955c-69eb4d63ddfd:5002f26b-5ee1-4d13-8b94-50a17485b726</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>1.3 Check Account Lockout  May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>users.dat  may be able to remotely execute code for 1.3 Check Account Lockout .</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Lock Flag and Failed Attempts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7544d07d9-cb53-40b4-b25c-8df548357be58063418a-4890-4f99-955c-69eb4d63ddfd5002f26b-5ee1-4d13-8b94-50a17485b726</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>8063418a-4890-4f99-955c-69eb4d63ddfd</b:FlowGuid><b:Id>81</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:8063418a-4890-4f99-955c-69eb4d63ddfd:5002f26b-5ee1-4d13-8b94-50a17485b726</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 1.3 Check Account Lockout </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 1.3 Check Account Lockout  in order to change the flow of program execution within 1.3 Check Account Lockout  to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Lock Flag and Failed Attempts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S19f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f63498892a-0426-4627-83b0-b1ce5ea7ba41544d07d9-cb53-40b4-b25c-8df548357be5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3498892a-0426-4627-83b0-b1ce5ea7ba41</b:FlowGuid><b:Id>82</b:Id><b:InteractionKey>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6:3498892a-0426-4627-83b0-b1ce5ea7ba41:544d07d9-cb53-40b4-b25c-8df548357be5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:47:36.1146723+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 1.4 Manage Attempt Counter Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.4 Manage Attempt Counter may be spoofed by an attacker and this may lead to unauthorized access to users.dat . </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>1.4 Manage Attempt Counter runs inline in AuthService.login() within the same JVM. It cannot be impersonated by an external entity. The counter is persisted atomically to users.dat after every login attempt (SEC-AUTH-04) — there is no in-memory-only state that could be bypassed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Attempt Counter, Lock Flag</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.19f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f63498892a-0426-4627-83b0-b1ce5ea7ba41544d07d9-cb53-40b4-b25c-8df548357be5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3498892a-0426-4627-83b0-b1ce5ea7ba41</b:FlowGuid><b:Id>83</b:Id><b:InteractionKey>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6:3498892a-0426-4627-83b0-b1ce5ea7ba41:544d07d9-cb53-40b4-b25c-8df548357be5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store users.dat </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>users.dat  may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of users.dat . Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Attempt Counter, Lock Flag</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T189f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f63498892a-0426-4627-83b0-b1ce5ea7ba41544d07d9-cb53-40b4-b25c-8df548357be5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3498892a-0426-4627-83b0-b1ce5ea7ba41</b:FlowGuid><b:Id>84</b:Id><b:InteractionKey>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6:3498892a-0426-4627-83b0-b1ce5ea7ba41:544d07d9-cb53-40b4-b25c-8df548357be5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:49:21.723182+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The users.dat  Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Attempt Counter, Lock Flag may be tampered with by an attacker. This may lead to corruption of users.dat . </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mitigated by SEC-DATA-01: all writes to users.dat use the atomic temp-file-then-rename pattern in UserRepository.persistAll() — Files.createTempFile() followed by Files.move() with StandardCopyOption.ATOMIC_MOVE. A power failure or crash during the counter update leaves either the old file or the new file fully intact, never a half-written record. The attempt counter and lock flag are only ever written by AuthService.login() (increment by 1 or reset to 0) and AdminMenu.lockAccount() (set true/false) — no other code path modifies these fields. Input validation (SEC-INP-02) prevents any injected data from reaching the write path.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Attempt Counter, Lock Flag</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R89f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f63498892a-0426-4627-83b0-b1ce5ea7ba41544d07d9-cb53-40b4-b25c-8df548357be5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3498892a-0426-4627-83b0-b1ce5ea7ba41</b:FlowGuid><b:Id>85</b:Id><b:InteractionKey>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6:3498892a-0426-4627-83b0-b1ce5ea7ba41:544d07d9-cb53-40b4-b25c-8df548357be5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies users.dat  Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>users.dat  claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Attempt Counter, Lock Flag</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D29f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f63498892a-0426-4627-83b0-b1ce5ea7ba41544d07d9-cb53-40b4-b25c-8df548357be5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3498892a-0426-4627-83b0-b1ce5ea7ba41</b:FlowGuid><b:Id>86</b:Id><b:InteractionKey>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6:3498892a-0426-4627-83b0-b1ce5ea7ba41:544d07d9-cb53-40b4-b25c-8df548357be5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 1.4 Manage Attempt Counter or users.dat </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 1.4 Manage Attempt Counter or users.dat  take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Attempt Counter, Lock Flag</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D49f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f63498892a-0426-4627-83b0-b1ce5ea7ba41544d07d9-cb53-40b4-b25c-8df548357be5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3498892a-0426-4627-83b0-b1ce5ea7ba41</b:FlowGuid><b:Id>87</b:Id><b:InteractionKey>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6:3498892a-0426-4627-83b0-b1ce5ea7ba41:544d07d9-cb53-40b4-b25c-8df548357be5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Attempt Counter, Lock Flag Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Attempt Counter, Lock Flag</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D59f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f63498892a-0426-4627-83b0-b1ce5ea7ba41544d07d9-cb53-40b4-b25c-8df548357be5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>3498892a-0426-4627-83b0-b1ce5ea7ba41</b:FlowGuid><b:Id>88</b:Id><b:InteractionKey>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6:3498892a-0426-4627-83b0-b1ce5ea7ba41:544d07d9-cb53-40b4-b25c-8df548357be5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Attempt Counter, Lock Flag</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9f7ca8a4-5ce8-4e0c-a9f2-7b29797ac1f6</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S11239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>89</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 1.2 Verify PBKDF2 Password  Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.2 Verify PBKDF2 Password  may be spoofed by an attacker and this may lead to unauthorized access to audit.log. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.11239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>90</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store audit.log</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>audit.log may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of audit.log. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T51239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>91</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:50:37.4837454+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Risks from Logging</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Log readers can come under attack via log files. Consider ways to canonicalize data in all logs. Implement a single reader for the logs, if possible, in order to reduce attack surface area. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mitigated by SEC-INP-02: InputValidator.isStorageSafe() rejects any pipe character ('|'), newline, or control character from all inputs before they reach AuditLogger. The username regex ^[A-Za-z0-9._-]{3,20}$ restricts what can appear in the actor field. An attacker cannot inject fake log lines or corrupt the log format.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T181239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>92</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:50:12.7904425+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The audit.log Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Login Event (SUCCESS or FAIL) may be tampered with by an attacker. This may lead to corruption of audit.log. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>audit.log uses StandardOpenOption.APPEND in AuditLogger.write() — each call adds a single line atomically at the end of the file. There is no read-modify-write operation in any code path. Combined with input validation (SEC-INP-02), the log cannot be corrupted through any application input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R11239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>93</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:52:25.0796113+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Lower Trusted Subject Updates Logs</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If you have trust levels, is anyone other outside of the highest trust level allowed to log? Letting everyone write to your logs can lead to repudiation problems. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Only the application process writes to audit.log. There is no user-facing operation that can update or delete log entries. AuditLogger.write() opens the file with StandardOpenOption.APPEND only — there is no overwrite or truncate operation in any code path. OS file-system permissions (operational control) prevent other users from modifying the file.&#xD;
</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R21239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>94</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Logs from an Unknown Source</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Do you accept logs from unknown or weakly authenticated users or systems? Identify and authenticate the source of the logs before accepting them.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R31239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>95</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:52:35.1858614+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insufficient Auditing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does the log capture enough data to understand what happened in the past? Do your logs capture enough data to understand an incident after the fact? Is such capture lightweight enough to be left on all the time? Do you have enough data to deal with repudiation claims? Make sure you log sufficient and appropriate data to handle a repudiation claims. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The audit log captures every security-relevant event: all login attempts (success and failure), account state changes (lock/unlock, register, remove), policy changes, shipment operations, profile updates, admin actions, and DENIED operations (failed authorization checks). The complete event reference is documented in Section 3.8 of ShipTrack_Full_Documentation.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R41239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>96</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Weak Protections for Audit Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Consider what happens when the audit mechanism comes under attack, including attempts to destroy the logs, or attack log analysis programs. Ensure access to the log is through a reference monitor, which controls read and write separately. Document what filters, if any, readers can rely on, or writers should expect</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R81239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>97</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies audit.log Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>audit.log claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D21239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>98</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 1.2 Verify PBKDF2 Password  or audit.log</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 1.2 Verify PBKDF2 Password  or audit.log take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D41239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>99</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Login Event (SUCCESS or FAIL) Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D51239d856-c2f6-4d21-9787-b3041a21c68ed5997764-a2cc-400a-9841-fcba7d9779cb812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>d5997764-a2cc-400a-9841-fcba7d9779cb</b:FlowGuid><b:Id>100</b:Id><b:InteractionKey>1239d856-c2f6-4d21-9787-b3041a21c68e:d5997764-a2cc-400a-9841-fcba7d9779cb:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Login Event (SUCCESS or FAIL)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>1239d856-c2f6-4d21-9787-b3041a21c68e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S15002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>101</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 1.3 Check Account Lockout  Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.3 Check Account Lockout  may be spoofed by an attacker and this may lead to unauthorized access to audit.log. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.15002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>102</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store audit.log</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>audit.log may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of audit.log. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T55002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>103</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:50:50.7765921+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Risks from Logging</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Log readers can come under attack via log files. Consider ways to canonicalize data in all logs. Implement a single reader for the logs, if possible, in order to reduce attack surface area. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Same as ID 91: InputValidator.isStorageSafe() and the username regex prevent injection of malicious content into log lines. The lock event format string is constructed by AuditLogger itself using sanitised fields, so an attacker cannot forge a lock event by manipulating their input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T185002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>104</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:50:18.5930154+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The audit.log Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Account Lock Event may be tampered with by an attacker. This may lead to corruption of audit.log. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>AuditLogger.write() opens audit.log with StandardOpenOption.APPEND only — each call adds a single line at the end of the file atomically. There is no read-modify-write operation anywhere in the codebase that could leave the log in a partially-written state. The data written to the log (username, action, result) is constructed entirely by AuditLogger from fields that have already passed InputValidator.isStorageSafe(), which rejects pipe characters (|), newlines, and any control character below code point 0x20. An attacker cannot inject a fake log line or break the line format by manipulating their inpu</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R15002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>105</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Lower Trusted Subject Updates Logs</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If you have trust levels, is anyone other outside of the highest trust level allowed to log? Letting everyone write to your logs can lead to repudiation problems. Only allow trusted code to log.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R25002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>106</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Logs from an Unknown Source</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Do you accept logs from unknown or weakly authenticated users or systems? Identify and authenticate the source of the logs before accepting them.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R35002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>107</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insufficient Auditing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does the log capture enough data to understand what happened in the past? Do your logs capture enough data to understand an incident after the fact? Is such capture lightweight enough to be left on all the time? Do you have enough data to deal with repudiation claims? Make sure you log sufficient and appropriate data to handle a repudiation claims. You might want to talk to an audit expert as well as a privacy expert about your choice of data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R45002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>108</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Weak Protections for Audit Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Consider what happens when the audit mechanism comes under attack, including attempts to destroy the logs, or attack log analysis programs. Ensure access to the log is through a reference monitor, which controls read and write separately. Document what filters, if any, readers can rely on, or writers should expect</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R85002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>109</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies audit.log Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>audit.log claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D25002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>110</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 1.3 Check Account Lockout  or audit.log</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 1.3 Check Account Lockout  or audit.log take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D45002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>111</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Account Lock Event Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D55002f26b-5ee1-4d13-8b94-50a17485b726fd943ee7-79e8-491c-8c90-eec255e67f95812386b4-c9cf-4227-bd69-4146df5a97f9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>fd943ee7-79e8-491c-8c90-eec255e67f95</b:FlowGuid><b:Id>112</b:Id><b:InteractionKey>5002f26b-5ee1-4d13-8b94-50a17485b726:fd943ee7-79e8-491c-8c90-eec255e67f95:812386b4-c9cf-4227-bd69-4146df5a97f9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lock Event</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5002f26b-5ee1-4d13-8b94-50a17485b726</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>812386b4-c9cf-4227-bd69-4146df5a97f9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7178d0e87-8c75-4441-8848-88f3ca72806001dc5c47-ab31-4a25-b093-3a01c90299e0311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>01dc5c47-ab31-4a25-b093-3a01c90299e0</b:FlowGuid><b:Id>113</b:Id><b:InteractionKey>178d0e87-8c75-4441-8848-88f3ca728060:01dc5c47-ab31-4a25-b093-3a01c90299e0:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store policy.cfg</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>policy.cfg may be spoofed by an attacker and this may lead to incorrect data delivered to 1.1 Validate Input . Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Password Policy Rules</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>178d0e87-8c75-4441-8848-88f3ca728060</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6178d0e87-8c75-4441-8848-88f3ca72806001dc5c47-ab31-4a25-b093-3a01c90299e0311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>01dc5c47-ab31-4a25-b093-3a01c90299e0</b:FlowGuid><b:Id>114</b:Id><b:InteractionKey>178d0e87-8c75-4441-8848-88f3ca728060:01dc5c47-ab31-4a25-b093-3a01c90299e0:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Password Policy Rules</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>178d0e87-8c75-4441-8848-88f3ca728060</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23178d0e87-8c75-4441-8848-88f3ca72806001dc5c47-ab31-4a25-b093-3a01c90299e0311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>01dc5c47-ab31-4a25-b093-3a01c90299e0</b:FlowGuid><b:Id>115</b:Id><b:InteractionKey>178d0e87-8c75-4441-8848-88f3ca728060:01dc5c47-ab31-4a25-b093-3a01c90299e0:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:53:05.7206094+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of policy.cfg can allow an attacker to read information not intended for disclosure. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Password policy thresholds are intentionally public-facing — they are displayed to users during registration when violations occur ("Need at least 1 uppercase letter"). Open Design principle (Saltzer &amp; Schroeder, Ch.2) confirms security must not depend on policy secrecy. Disclosure of the policy does not weaken security in any way.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Password Policy Rules</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>178d0e87-8c75-4441-8848-88f3ca728060</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3178d0e87-8c75-4441-8848-88f3ca72806001dc5c47-ab31-4a25-b093-3a01c90299e0311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>01dc5c47-ab31-4a25-b093-3a01c90299e0</b:FlowGuid><b:Id>116</b:Id><b:InteractionKey>178d0e87-8c75-4441-8848-88f3ca728060:01dc5c47-ab31-4a25-b093-3a01c90299e0:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>1.1 Validate Input  crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Password Policy Rules</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>178d0e87-8c75-4441-8848-88f3ca728060</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4178d0e87-8c75-4441-8848-88f3ca72806001dc5c47-ab31-4a25-b093-3a01c90299e0311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>01dc5c47-ab31-4a25-b093-3a01c90299e0</b:FlowGuid><b:Id>117</b:Id><b:InteractionKey>178d0e87-8c75-4441-8848-88f3ca728060:01dc5c47-ab31-4a25-b093-3a01c90299e0:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Password Policy Rules Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Password Policy Rules</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>178d0e87-8c75-4441-8848-88f3ca728060</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5178d0e87-8c75-4441-8848-88f3ca72806001dc5c47-ab31-4a25-b093-3a01c90299e0311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>01dc5c47-ab31-4a25-b093-3a01c90299e0</b:FlowGuid><b:Id>118</b:Id><b:InteractionKey>178d0e87-8c75-4441-8848-88f3ca728060:01dc5c47-ab31-4a25-b093-3a01c90299e0:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Password Policy Rules</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>178d0e87-8c75-4441-8848-88f3ca728060</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6178d0e87-8c75-4441-8848-88f3ca72806001dc5c47-ab31-4a25-b093-3a01c90299e0311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>01dc5c47-ab31-4a25-b093-3a01c90299e0</b:FlowGuid><b:Id>119</b:Id><b:InteractionKey>178d0e87-8c75-4441-8848-88f3ca728060:01dc5c47-ab31-4a25-b093-3a01c90299e0:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>1.1 Validate Input  May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>policy.cfg may be able to remotely execute code for 1.1 Validate Input .</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Password Policy Rules</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>178d0e87-8c75-4441-8848-88f3ca728060</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7178d0e87-8c75-4441-8848-88f3ca72806001dc5c47-ab31-4a25-b093-3a01c90299e0311471d4-ba17-4555-9b3e-9529fac83423</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>01dc5c47-ab31-4a25-b093-3a01c90299e0</b:FlowGuid><b:Id>120</b:Id><b:InteractionKey>178d0e87-8c75-4441-8848-88f3ca728060:01dc5c47-ab31-4a25-b093-3a01c90299e0:311471d4-ba17-4555-9b3e-9529fac83423</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 1.1 Validate Input </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 1.1 Validate Input  in order to change the flow of program execution within 1.1 Validate Input  to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Password Policy Rules</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>178d0e87-8c75-4441-8848-88f3ca728060</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>311471d4-ba17-4555-9b3e-9529fac83423</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b0261300fef01-3e35-4607-9161-0616ee4df07ea92894f2-5735-4d25-89f9-626b0f49be9ed03ad352-03a2-4423-89f4-72b3173d5ee2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>a92894f2-5735-4d25-89f9-626b0f49be9e</b:FlowGuid><b:Id>144</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:a92894f2-5735-4d25-89f9-626b0f49be9e:d03ad352-03a2-4423-89f4-72b3173d5ee2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting. The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Package Description</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>d03ad352-03a2-4423-89f4-72b3173d5ee2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7300fef01-3e35-4607-9161-0616ee4df07ea92894f2-5735-4d25-89f9-626b0f49be9ed03ad352-03a2-4423-89f4-72b3173d5ee2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>a92894f2-5735-4d25-89f9-626b0f49be9e</b:FlowGuid><b:Id>143</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:a92894f2-5735-4d25-89f9-626b0f49be9e:d03ad352-03a2-4423-89f4-72b3173d5ee2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 2.1 Create Shipment Request </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 2.1 Create Shipment Request  in order to change the flow of program execution within 2.1 Create Shipment Request  to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Package Description</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>d03ad352-03a2-4423-89f4-72b3173d5ee2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6300fef01-3e35-4607-9161-0616ee4df07ea92894f2-5735-4d25-89f9-626b0f49be9ed03ad352-03a2-4423-89f4-72b3173d5ee2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>a92894f2-5735-4d25-89f9-626b0f49be9e</b:FlowGuid><b:Id>142</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:a92894f2-5735-4d25-89f9-626b0f49be9e:d03ad352-03a2-4423-89f4-72b3173d5ee2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>2.1 Create Shipment Request  May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Customer may be able to remotely execute code for 2.1 Create Shipment Request .</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Package Description</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>300fef01-3e35-4607-9161-0616ee4df07e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>d03ad352-03a2-4423-89f4-72b3173d5ee2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5300fef01-3e35-4607-9161-0616ee4df07ea92894f2-5735-4d25-89f9-626b0f49be9ed03ad352-03a2-4423-89f4-72b3173d5ee2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>a92894f2-5735-4d25-89f9-626b0f49be9e</b:FlowGuid><b:Id>141</b:Id><b:InteractionKey>300fef01-3e35-4607-9161-0616ee4df07e:a92894f2-5735-4d25-89f9-626b0f49be9e:d03ad352-03a2-4423-89f4-72b3173d5ee2</b:InteractionKey><b:Inter