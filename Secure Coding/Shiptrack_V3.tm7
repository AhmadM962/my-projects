ueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6260a99f-7361-44eb-9ad4-805c568f6bef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R66260a99f-7361-44eb-9ad4-805c568f6befcdc87f95-fe83-40cc-8001-32e78dc11fb12718b34a-c9ae-4b5b-8c60-020c6bd33cf4</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>cdc87f95-fe83-40cc-8001-32e78dc11fb1</b:FlowGuid><b:Id>230</b:Id><b:InteractionKey>6260a99f-7361-44eb-9ad4-805c568f6bef:cdc87f95-fe83-40cc-8001-32e78dc11fb1:2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 2.3 Assign Delivery to Driver </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.3 Assign Delivery to Driver  claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and s