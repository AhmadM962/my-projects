erties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in 2.3 Assign Delivery to Driver </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into 2.3 Assign Delivery to Driver  in order to change the flow of program execution within 2.3 Assign Delivery to Driver  to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value> Shipment Record</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6260a99f-7361-44eb-9ad4-805c568f6bef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S12718b34a-c9ae-4b5b-8c60-020c6bd33cf46998fbf6-5ab9-4784-9799-09734ec4fa686260a99f-7361-44eb-9ad4-805c568f6bef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6998fbf6-5ab9-4784-9799-09734ec4fa68</b:FlowGuid><b:Id>237</b:Id><b:InteractionKey>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4:6998fbf6-5ab9-4784-9799-09734ec4fa68:6260a99f-7361-44eb-9ad4-805c568f6bef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the 2.3 Assign Delivery to Driver  Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.3 Assign Delivery to Driver  may be spoofed by an attacker and this may lead to unauthorized access to shipments.dat . Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Driver Assignment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6260a99f-7361-44eb-9ad4-805c568f6bef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.12718b34a-c9ae-4b5b-8c60-020c6bd33cf46998fbf6-5ab9-4784-9799-09734ec4fa686260a99f-7361-44eb-9ad4-805c568f6bef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6998fbf6-5ab9-4784-9799-09734ec4fa68</b:FlowGuid><b:Id>238</b:Id><b:InteractionKey>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4:6998fbf6-5ab9-4784-9799-09734ec4fa68:6260a99f-7361-44eb-9ad4-805c568f6bef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store shipments.dat </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>shipments.dat  may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of shipments.dat . Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Driver Assignment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6260a99f-7361-44eb-9ad4-805c568f6bef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T182718b34a-c9ae-4b5b-8c60-020c6bd33cf46998fbf6-5ab9-4784-9799-09734ec4fa686260a99f-7361-44eb-9ad4-805c568f6bef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6998fbf6-5ab9-4784-9799-09734ec4fa68</b:FlowGuid><b:Id>239</b:Id><b:InteractionKey>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4:6998fbf6-5ab9-4784-9799-09734ec4fa68:6260a99f-7361-44eb-9ad4-805c568f6bef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:49:44.1715491+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>The shipments.dat  Data Store Could Be Corrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Driver Assignment may be tampered with by an attacker. This may lead to corruption of shipments.dat .</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Atomic writes via ATOMIC_MOVE. The driver username being assigned is validated against the regex ^[A-Za-z0-9._-]{3,20}$ before being written, and the user must exist with role DELIVERY_PERSONNEL (verified in DispatcherMenu.assignDelivery() — Least Privilege check).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Driver Assignment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6260a99f-7361-44eb-9ad4-805c568f6bef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R82718b34a-c9ae-4b5b-8c60-020c6bd33cf46998fbf6-5ab9-4784-9799-09734ec4fa686260a99f-7361-44eb-9ad4-805c568f6bef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6998fbf6-5ab9-4784-9799-09734ec4fa68</b:FlowGuid><b:Id>240</b:Id><b:InteractionKey>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4:6998fbf6-5ab9-4784-9799-09734ec4fa68:6260a99f-7361-44eb-9ad4-805c568f6bef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies shipments.dat  Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>shipments.dat  claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Driver Assignment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6260a99f-7361-44eb-9ad4-805c568f6bef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D22718b34a-c9ae-4b5b-8c60-020c6bd33cf46998fbf6-5ab9-4784-9799-09734ec4fa686260a99f-7361-44eb-9ad4-805c568f6bef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6998fbf6-5ab9-4784-9799-09734ec4fa68</b:FlowGuid><b:Id>241</b:Id><b:InteractionKey>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4:6998fbf6-5ab9-4784-9799-09734ec4fa68:6260a99f-7361-44eb-9ad4-805c568f6bef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for 2.3 Assign Delivery to Driver  or shipments.dat </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does 2.3 Assign Delivery to Driver  or shipments.dat  take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Driver Assignment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6260a99f-7361-44eb-9ad4-805c568f6bef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D42718b34a-c9ae-4b5b-8c60-020c6bd33cf46998fbf6-5ab9-4784-9799-09734ec4fa686260a99f-7361-44eb-9ad4-805c568f6bef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6998fbf6-5ab9-4784-9799-09734ec4fa68</b:FlowGuid><b:Id>242</b:Id><b:InteractionKey>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4:6998fbf6-5ab9-4784-9799-09734ec4fa68:6260a99f-7361-44eb-9ad4-805c568f6bef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Driver Assignment Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Driver Assignment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6260a99f-7361-44eb-9ad4-805c568f6bef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D52718b34a-c9ae-4b5b-8c60-020c6bd33cf46998fbf6-5ab9-4784-9799-09734ec4fa686260a99f-7361-44eb-9ad4-805c568f6bef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>6998fbf6-5ab9-4784-9799-09734ec4fa68</b:FlowGuid><b:Id>243</b:Id><b:InteractionKey>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4:6998fbf6-5ab9-4784-9799-09734ec4fa68:6260a99f-7361-44eb-9ad4-805c568f6bef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Driver Assignment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6260a99f-7361-44eb-9ad4-805c568f6bef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7544d07d9-cb53-40b4-b25c-8df548357be5bcb6fa45-f2e6-4997-936d-6df09b0783b92718b34a-c9ae-4b5b-8c60-020c6bd33cf4</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>bcb6fa45-f2e6-4997-936d-6df09b0783b9</b:FlowGuid><b:Id>244</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:bcb6fa45-f2e6-4997-936d-6df09b0783b9:2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store users.dat </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>users.dat  may be spoofed by an attacker and this may lead to incorrect data delivered to 2.3 Assign Delivery to Driver . Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Read Driver Account (role check)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6544d07d9-cb53-40b4-b25c-8df548357be5bcb6fa45-f2e6-4997-936d-6df09b0783b92718b34a-c9ae-4b5b-8c60-020c6bd33cf4</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>bcb6fa45-f2e6-4997-936d-6df09b0783b9</b:FlowGuid><b:Id>245</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:bcb6fa45-f2e6-4997-936d-6df09b0783b9:2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by 2.3 Assign Delivery to Driver </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.3 Assign Delivery to Driver  claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Read Driver Account (role check)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23544d07d9-cb53-40b4-b25c-8df548357be5bcb6fa45-f2e6-4997-936d-6df09b0783b92718b34a-c9ae-4b5b-8c60-020c6bd33cf4</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>PC\ahmad</b:ChangedBy><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>bcb6fa45-f2e6-4997-936d-6df09b0783b9</b:FlowGuid><b:Id>246</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:bcb6fa45-f2e6-4997-936d-6df09b0783b9:2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-06-06T17:53:16.5945944+03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of users.dat  can allow an attacker to read information not intended for disclosure. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The role check in DispatcherMenu.assignDelivery() reads only the Role field of a user via UserRepository.findByUsername(driverUsername) — it does NOT expose the hash, salt, ID number, or contact details. The check returns only a boolean (is this user a DELIVERY_PERSONNEL?). Minimal information disclosure by design.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Read Driver Account (role check)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c-8df548357be5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3544d07d9-cb53-40b4-b25c-8df548357be5bcb6fa45-f2e6-4997-936d-6df09b0783b92718b34a-c9ae-4b5b-8c60-020c6bd33cf4</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f9cfa17b-9098-466d-94a6-c2c5c8cfa594</b:DrawingSurfaceGuid><b:FlowGuid>bcb6fa45-f2e6-4997-936d-6df09b0783b9</b:FlowGuid><b:Id>247</b:Id><b:InteractionKey>544d07d9-cb53-40b4-b25c-8df548357be5:bcb6fa45-f2e6-4997-936d-6df09b0783b9:2718b34a-c9ae-4b5b-8c60-020c6bd33cf4</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for 2.3 Assign Delivery to Driver </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>2.3 Assign Delivery to Driver  crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Read Driver Account (role check)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>544d07d9-cb53-40b4-b25c